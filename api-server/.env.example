# --- 로컬 개발(기본값: SQLite 파일 하나로 바로 실행) ---
APP_ENV=development
APP_NAME=Home OnQ API
DATABASE_URL=sqlite:///./homeonq_dev.db
AUTO_CREATE_SCHEMA=true

# Expo web / Expo Go(LAN) 개발 오리진. 운영에서는 실제 도메인만 남긴다.
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006","http://127.0.0.1:19006"]

# 개발 전용 JWT 서명키(32자 이상). 운영에서는 반드시 교체.
JWT_SECRET=development-only-change-this-secret-before-use-32bytes-min
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- 운영(PostgreSQL) 예시 ---
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://homeonq:CHANGE_ME@localhost:5432/homeonq
# AUTO_CREATE_SCHEMA=false
# CORS_ORIGINS=["https://homeonq.example.com"]
# JWT_SECRET=<openssl rand -base64 48 로 생성>
