# --- 백엔드 연결 ---
SERVER_MODE=HTTP                     # MOCK | HTTP
SERVER_URL=http://localhost:8000
DEVICE_TOKEN=demo-edge-token-homeonq-0001
DEVICE_ID=DEMO-EDGE-01
SENIOR_NAME=강O순 어르신

# --- 입력 ---
# mock | 0(웹캠) | rtsp://아이피:554/... | 동영상 파일 경로
CAMERA_SOURCE=mock
# 긴 무활동/배회를 짧은 클립으로 시연할 때의 시간 배속
TIME_SCALE=1

# --- 안정성/분석 임계값 ---
DB_PATH=local_events.db
FRAME_TIMEOUT=30
INFERENCE_TIMEOUT=60
REPORTING_TIMEOUT=180
INACTIVITY_MINUTES=240
WANDERING_MINUTES=5
FALL_CONFIDENCE_THRESHOLD=0.55

# --- Gemini(선택) ---
# 키가 없거나 호출이 실패하면 한국어 규칙 기반 리포트로 자동 대체된다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- MediaPipe(선택) ---
POSE_MODEL_PATH=models/pose_landmarker_lite.task
USE_MEDIAPIPE=auto

# --- AI 행동 분류 모델(선택) ---
# 학습된 .onnx + 같은 이름의 .json 메타데이터가 있으면 규칙 대신/함께 AI 판정을 사용한다.
# 파일이 없거나 onnxruntime 미설치·특징 버전 불일치면 조용히 규칙 기반으로 폴백한다.
ACTION_MODEL_PATH=models/action_classifier.onnx
USE_ACTION_MODEL=auto            # auto | on | off
MODEL_FALL_THRESHOLD=0.6
MODEL_INACTIVITY_THRESHOLD=0.6
MODEL_WANDERING_THRESHOLD=0.6
MODEL_INACTIVITY_MIN_WINDOWS=3
MODEL_WANDERING_MIN_WINDOWS=2
MODEL_WANDERING_MIN_SECONDS=5
